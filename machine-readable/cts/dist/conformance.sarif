{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cts-conformance",
          "version": "0.2.10",
          "rules": [
            {
              "id": "conflict_legible",
              "shortDescription": {
                "text": "CTS (4.1): conflict events are legible in the coordination record"
              }
            },
            {
              "id": "graduated_architecture_present",
              "shortDescription": {
                "text": "CTS (4.2): a graduated engagement spine with adjudication last, not first"
              }
            },
            {
              "id": "proactive_disposition_protected",
              "shortDescription": {
                "text": "CTS (4.3): proactive engagement is not structurally penalized"
              }
            },
            {
              "id": "transformation_capacity_provisioned",
              "shortDescription": {
                "text": "CTS (4.4): operator capacity is structurally provisioned, not volunteer-dependent"
              }
            },
            {
              "id": "engagement_recognized",
              "shortDescription": {
                "text": "CTS (4.5): conflict engagement is recognized as coordination work"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "conflict_legible",
          "level": "none",
          "message": {
            "text": "CTS (4.1): conflict events are legible in the coordination record: satisfied"
          }
        },
        {
          "ruleId": "graduated_architecture_present",
          "level": "none",
          "message": {
            "text": "CTS (4.2): a graduated engagement spine with adjudication last, not first: satisfied"
          }
        },
        {
          "ruleId": "proactive_disposition_protected",
          "level": "none",
          "message": {
            "text": "CTS (4.3): proactive engagement is not structurally penalized: satisfied"
          }
        },
        {
          "ruleId": "transformation_capacity_provisioned",
          "level": "none",
          "message": {
            "text": "CTS (4.4): operator capacity is structurally provisioned, not volunteer-dependent: satisfied"
          }
        },
        {
          "ruleId": "engagement_recognized",
          "level": "none",
          "message": {
            "text": "CTS (4.5): conflict engagement is recognized as coordination work: satisfied"
          }
        }
      ]
    }
  ]
}
