{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ros-conformance",
          "version": "0.1.8",
          "rules": [
            {
              "id": "extraction_visible",
              "shortDescription": {
                "text": "ROS invariant (2.2): extraction visible in the record"
              }
            },
            {
              "id": "three_conditions_met",
              "shortDescription": {
                "text": "ROS invariant (2.2): return satisfies all three validity conditions"
              }
            },
            {
              "id": "stance_declared",
              "shortDescription": {
                "text": "ROS invariant (2.2): stance declared in a verifiable public record"
              }
            },
            {
              "id": "no_retroactive_reclassification",
              "shortDescription": {
                "text": "ROS invariant (2.2): no retroactive reclassification of extraction events"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "extraction_visible",
          "level": "none",
          "message": {
            "text": "ROS invariant (2.2): extraction visible in the record: satisfied"
          }
        },
        {
          "ruleId": "three_conditions_met",
          "level": "none",
          "message": {
            "text": "ROS invariant (2.2): return satisfies all three validity conditions: satisfied"
          }
        },
        {
          "ruleId": "stance_declared",
          "level": "none",
          "message": {
            "text": "ROS invariant (2.2): stance declared in a verifiable public record: satisfied"
          }
        },
        {
          "ruleId": "no_retroactive_reclassification",
          "level": "none",
          "message": {
            "text": "ROS invariant (2.2): no retroactive reclassification of extraction events: satisfied"
          }
        }
      ]
    }
  ]
}
