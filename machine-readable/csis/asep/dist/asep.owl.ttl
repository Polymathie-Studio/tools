    skos:inScheme <https://standards.example/asep> .

asep:tamper_evident a owl:DatatypeProperty ;
    rdfs:label "tamper_evident" ;
    skos:inScheme <https://standards.example/asep> .

asep:time_to_assessment a owl:DatatypeProperty ;
    rdfs:label "time_to_assessment" ;
    skos:definition "ASEP 3.3.1. The recorded first substantive look against the per-severity bound." ;
