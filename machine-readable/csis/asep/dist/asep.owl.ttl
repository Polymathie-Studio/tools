    skos:inScheme <https://standards.example/asep> .

asep:DispositionKind a owl:Class ;
    rdfs:label "DispositionKind" ;
    owl:unionOf ( <https://standards.example/asep/DispositionKind#act> <https://standards.example/asep/DispositionKind#monitor> <https://standards.example/asep/DispositionKind#close> ) ;
    skos:definition "ASEP 2.2. The finite-path terminal outcomes." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/DispositionKind#act>,
        <https://standards.example/asep/DispositionKind#close>,
        <https://standards.example/asep/DispositionKind#monitor> .

asep:RootCauseKind a owl:Class ;
    rdfs:label "RootCauseKind" ;
    owl:unionOf ( <https://standards.example/asep/RootCauseKind#no_structural_condition> <https://standards.example/asep/RootCauseKind#structural_condition_identified> <https://standards.example/asep/RootCauseKind#insufficient_information> ) ;
    skos:definition "ASEP 3.3.3. The three structural root cause findings." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/RootCauseKind#insufficient_information>,
        <https://standards.example/asep/RootCauseKind#no_structural_condition>,
        <https://standards.example/asep/RootCauseKind#structural_condition_identified> .

asep:Severity a owl:Class ;
    rdfs:label "Severity" ;
    owl:unionOf ( <https://standards.example/asep/Severity#low> <https://standards.example/asep/Severity#medium> <https://standards.example/asep/Severity#high> ) ;
    skos:definition "ASEP 3.3.2. Graduated severity." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/Severity#high>,
        <https://standards.example/asep/Severity#low>,
        <https://standards.example/asep/Severity#medium> .

asep:ComplexityDomain a owl:Class ;
    rdfs:label "ComplexityDomain" ;
    owl:unionOf ( <https://standards.example/asep/ComplexityDomain#clear> <https://standards.example/asep/ComplexityDomain#complicated> <https://standards.example/asep/ComplexityDomain#complex> <https://standards.example/asep/ComplexityDomain#chaotic> ) ;
    skos:definition "ASEP 3.3.6, 3.3.7. The Cynefin domains." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/ComplexityDomain#chaotic>,
        <https://standards.example/asep/ComplexityDomain#clear>,
        <https://standards.example/asep/ComplexityDomain#complex>,
        <https://standards.example/asep/ComplexityDomain#complicated> .

asep:AdoptionTier a owl:Class ;
    rdfs:label "AdoptionTier" ;
    owl:unionOf ( <https://standards.example/asep/AdoptionTier#assessed> <https://standards.example/asep/AdoptionTier#operational> <https://standards.example/asep/AdoptionTier#instrumented> <https://standards.example/asep/AdoptionTier#loop_closed> <https://standards.example/asep/AdoptionTier#auditable> ) ;
    skos:definition "ASEP 5. The adoption tiers." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/AdoptionTier#assessed>,
        <https://standards.example/asep/AdoptionTier#auditable>,
        <https://standards.example/asep/AdoptionTier#instrumented>,
        <https://standards.example/asep/AdoptionTier#loop_closed>,
        <https://standards.example/asep/AdoptionTier#operational> .

asep:ConformanceAnswer a owl:Class ;
    rdfs:label "ConformanceAnswer" ;
    owl:unionOf ( <https://standards.example/asep/ConformanceAnswer#satisfied> <https://standards.example/asep/ConformanceAnswer#declared_absent_with_justification> <https://standards.example/asep/ConformanceAnswer#not_applicable> ) ;
    skos:definition "ASEP. Per-invariant answer; silence is not one of the values." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/ConformanceAnswer#declared_absent_with_justification>,
        <https://standards.example/asep/ConformanceAnswer#not_applicable>,
        <https://standards.example/asep/ConformanceAnswer#satisfied> .

asep:EscalationStage a owl:Class ;
    rdfs:label "EscalationStage" ;
    owl:unionOf ( <https://standards.example/asep/EscalationStage#generated> <https://standards.example/asep/EscalationStage#acknowledged> <https://standards.example/asep/EscalationStage#auto_escalated> <https://standards.example/asep/EscalationStage#obligation_triggered> <https://standards.example/asep/EscalationStage#terminal_visibility> ) ;
    skos:definition "ASEP 3.3.6. The time-governed escalation stages." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/EscalationStage#acknowledged>,
        <https://standards.example/asep/EscalationStage#auto_escalated>,
        <https://standards.example/asep/EscalationStage#generated>,
        <https://standards.example/asep/EscalationStage#obligation_triggered>,
        <https://standards.example/asep/EscalationStage#terminal_visibility> .

asep:NavigateAction a owl:Class ;
    rdfs:label "NavigateAction" ;
    owl:unionOf ( <https://standards.example/asep/NavigateAction#mitigate_or_contain> <https://standards.example/asep/NavigateAction#escalate> <https://standards.example/asep/NavigateAction#initiate_engagement> <https://standards.example/asep/NavigateAction#monitor> <https://standards.example/asep/NavigateAction#close> ) ;
    skos:definition "ASEP 3.3.1. The bounded action set." ;
    skos:inScheme <https://standards.example/asep> ;
    linkml:permissible_values <https://standards.example/asep/NavigateAction#close>,
        <https://standards.example/asep/NavigateAction#escalate>,
        <https://standards.example/asep/NavigateAction#initiate_engagement>,
        <https://standards.example/asep/NavigateAction#mitigate_or_contain>,
        <https://standards.example/asep/NavigateAction#monitor> .

asep:rationale a owl:DatatypeProperty .


