<https://standards.example/asep/ComplexityDomain#complex> a owl:Class ;
    rdfs:label "complex" ;
    rdfs:subClassOf asep:ComplexityDomain .

<https://standards.example/asep/ComplexityDomain#complicated> a owl:Class ;
    rdfs:label "complicated" ;
    rdfs:subClassOf asep:ComplexityDomain .

<https://standards.example/asep/ConformanceAnswer#declared_absent_with_justification> a owl:Class ;
    rdfs:label "declared_absent_with_justification" ;
