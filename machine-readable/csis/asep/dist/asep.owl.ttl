@prefix asep: <https://standards.example/asep/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://standards.example/asep.owl.ttl> a owl:Ontology ;
    rdfs:label "asep" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "ASEP adverse-signal record" ;
    skos:definition """The one canonical source for the machine-readable layer of the Adverse-Signal Engagement Principle Core Standard (standards-3_0-adverse-signal-engagement, v0.7.13). ASEP is a process-and-detection standard, so the tree root is a per-signal AdverseSignalRecord that carries one adverse signal through the Notice, Name, and Navigate lifecycle and the time-governed Signal Escalation state; the system-level obligations (the adopted tier, the classification framework, the logging paths, the escalation architecture) are an ASEPArchitecture the record declares its context against. Every artifact in dist/ is generated from this file.
The structural obligations (which lifecycle steps and log fields must be present, which escalation stage was reached) are modeled here. The interpretive obligations are not schema-expressible and belong to the conformance checker: severity classification, proportionality of observation, coverage adequacy of the framework, cost-bearing-party participation, whether an action was retaliatory, and genuine transformation of a conflict-class signal. asep-register.yaml marks each requirement shape, judgment, or mixed.
Tier-gating (which obligations bind at Assessed, Operational, Instrumented, Loop-Closed, or Auditable) is enforced by the checker against the register's tier field, so the schema models the full shape with tier-gated blocks optional rather than encoding enum-precondition rules. The audit's reliability is bounded by the Four Batteries Relational Battery condition, a cross-standard dependency, not a field here.""" .

asep:AdverseSignalRecord a owl:Class ;
    rdfs:label "AdverseSignalRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom asep:Disposition ;
            owl:onProperty asep:disposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:escalation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:disposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:Source ;
            owl:onProperty asep:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:conformance ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:Navigate ;
            owl:onProperty asep:navigate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:observation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:disposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:observation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:escalation ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:Classification ;
            owl:onProperty asep:classification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:conformance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:navigate ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:EscalationState ;
            owl:onProperty asep:escalation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:classification ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:Observation ;
            owl:onProperty asep:observation ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ConformanceDeclaration ;
            owl:onProperty asep:conformance ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ASEPArchitecture ;
            owl:onProperty asep:architecture ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:navigate ] ;
    skos:definition "One adverse signal carried through Notice, Name, and Navigate, with its escalation state and terminal disposition on the face." ;
    skos:inScheme <https://standards.example/asep> .

asep:ASEPArchitecture a owl:Class ;
    rdfs:label "ASEPArchitecture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:escalation_architecture_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:reliability_disclosure ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ClassificationFramework ;
            owl:onProperty asep:classification_framework ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:escalation_architecture_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:reliability_disclosure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:anti_retaliation_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:classification_framework ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:anti_retaliation_policy ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:AdoptionTier ;
            owl:onProperty asep:adopted_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:classification_framework ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:reliability_disclosure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:escalation_architecture_present ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:adopted_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:logging ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:LoggingPaths ;
            owl:onProperty asep:logging ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:logging ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:anti_retaliation_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:adopted_tier ] ;
    skos:definition "The system-level ASEP context. Higher-tier blocks are optional in the schema; the checker requires them at the tiers the register specifies." ;
    skos:inScheme <https://standards.example/asep> .

asep:Classification a owl:Class ;
    rdfs:label "Classification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:complexity_domain ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:complexity_domain ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:Severity ;
            owl:onProperty asep:severity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:category ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:framework_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:framework_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:severity ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ComplexityDomain ;
            owl:onProperty asep:complexity_domain ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:framework_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:severity ] ;
    skos:definition "ASEP 3.2.2. Category and severity assigned against the ex-ante versioned framework." ;
    skos:inScheme <https://standards.example/asep> .

asep:ClassificationFramework a owl:Class ;
    rdfs:label "ClassificationFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:coverage_review ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:ex_ante ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:ex_ante ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:coverage_review ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:coverage_review ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:ex_ante ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:version ] ;
    skos:definition "ASEP 3.2.2. The adverse-signal categories and severity levels." ;
    skos:inScheme <https://standards.example/asep> .

asep:ConflictEngagement a owl:Class ;
    rdfs:label "ConflictEngagement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:pathway_opened ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:documented_exchange ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:documented_exchange ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:pathway_opened ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:documented_exchange ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:pathway_opened ] ;
    skos:definition "ASEP 3.3.1a. The engagement pathway for a conflict-class signal." ;
    skos:inScheme <https://standards.example/asep> .

asep:ConformanceDeclaration a owl:Class ;
    rdfs:label "ConformanceDeclaration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:no_silent_erasure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:ex_ante_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:ex_ante_criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ConformanceAnswer ;
            owl:onProperty asep:ex_ante_criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ConformanceAnswer ;
            owl:onProperty asep:no_silent_erasure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:finite_path_to_decision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:no_silent_erasure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:finite_path_to_decision ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ConformanceAnswer ;
            owl:onProperty asep:finite_path_to_decision ] ;
    skos:definition "ASEP 2.2. The three invariant answers on the face. There is deliberately no overall or total field: conformance is per-invariant, mirroring the suite's refusal to collapse a profile into a single number." ;
    skos:inScheme <https://standards.example/asep> .

asep:Disposition a owl:Class ;
    rdfs:label "Disposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:non_adverse_judgment_recorded ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:non_adverse_judgment_recorded ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:non_adverse_judgment_recorded ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:DispositionKind ;
            owl:onProperty asep:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:kind ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:rationale ] ;
    skos:definition "ASEP 2.2. The terminal disposition on the finite path to decision." ;
    skos:inScheme <https://standards.example/asep> .

asep:EscalationState a owl:Class ;
    rdfs:label "EscalationState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom asep:EscalationStage ;
            owl:onProperty asep:stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:window_pre_specified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:acknowledgment_window ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:acknowledgment_window ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:window_pre_specified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:window_pre_specified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:acknowledgment_window ] ;
    skos:definition "ASEP 3.3.6. The time-governed Signal Escalation stage, driven by elapsed time not human initiative." ;
    skos:inScheme <https://standards.example/asep> .

asep:LoggingPaths a owl:Class ;
    rdfs:label "LoggingPaths" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:tamper_evident ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:durable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:tamper_evident ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:independent_of_evaluated_actors ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:durable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:independent_of_evaluated_actors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:tamper_evident ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty asep:durable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:independent_of_evaluated_actors ] ;
    skos:definition "ASEP 3.2.1, 4.3. Durability and independence of the logs." ;
    skos:inScheme <https://standards.example/asep> .

asep:Navigate a owl:Class ;
    rdfs:label "Navigate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:time_to_assessment ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:NavigateAction ;
            owl:onProperty asep:action ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:time_to_assessment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:structural_root_cause_finding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:time_to_first_decision ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:time_to_first_decision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:conflict_engagement ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:RootCauseFinding ;
            owl:onProperty asep:structural_root_cause_finding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:conflict_engagement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:action ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:time_to_assessment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:rationale ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:ConflictEngagement ;
            owl:onProperty asep:conflict_engagement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:structural_root_cause_finding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:action ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:time_to_first_decision ] ;
    skos:definition "ASEP 3.3. The signal-processing lifecycle from assessment through decision." ;
    skos:inScheme <https://standards.example/asep> .

asep:Observation a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:who_affected ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:who_affected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:power_context ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:when ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:where ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:power_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:when ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty asep:power_context ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:where ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:where ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:who_affected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:when ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:description ] ;
    skos:definition "ASEP 3.2.1. The durable log entry, observation separated from evaluation." ;
    skos:inScheme <https://standards.example/asep> .

asep:RootCauseFinding a owl:Class ;
    rdfs:label "RootCauseFinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:finding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:finding ],
        [ a owl:Restriction ;
            owl:allValuesFrom asep:RootCauseKind ;
            owl:onProperty asep:finding ] ;
    skos:definition "ASEP 3.3.3. The structural root cause assessment finding." ;
    skos:inScheme <https://standards.example/asep> .

asep:Source a owl:Class ;
    rdfs:label "Source" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:reporter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:reporter ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty asep:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty asep:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:reporter ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty asep:role ] ;
    skos:definition "ASEP 3.2.1, 4.2. Any actor may log a signal that meets minimal criteria." ;
    skos:inScheme <https://standards.example/asep> .

<https://standards.example/asep/AdoptionTier#assessed> a owl:Class ;
    rdfs:label "assessed" ;
    rdfs:subClassOf asep:AdoptionTier .

<https://standards.example/asep/AdoptionTier#auditable> a owl:Class ;
    rdfs:label "auditable" ;
    rdfs:subClassOf asep:AdoptionTier .

<https://standards.example/asep/AdoptionTier#instrumented> a owl:Class ;
    rdfs:label "instrumented" ;
    rdfs:subClassOf asep:AdoptionTier .

