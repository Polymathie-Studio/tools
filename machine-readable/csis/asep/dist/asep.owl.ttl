asep:acknowledgment_window a owl:DatatypeProperty ;
    rdfs:label "acknowledgment_window" ;
    skos:definition "ASEP 3.3.6. The maximum elapsed time from generation to first acknowledgment, pre-specified." ;
    skos:inScheme <https://standards.example/asep> .

asep:action a owl:ObjectProperty ;
    rdfs:label "action" ;
    skos:definition "ASEP 3.3.1. The action chosen from the bounded set." ;
    skos:inScheme <https://standards.example/asep> .

asep:adopted_tier a owl:ObjectProperty ;
    rdfs:label "adopted_tier" ;
    skos:inScheme <https://standards.example/asep> .

asep:anti_retaliation_policy a owl:DatatypeProperty ;
    rdfs:label "anti_retaliation_policy" ;
    skos:definition "ASEP 4.1. Explicit anti-retaliation commitment (required by the checker at Instrumented and above)." ;
    skos:inScheme <https://standards.example/asep> .

asep:architecture a owl:ObjectProperty ;
    rdfs:label "architecture" ;
    skos:definition "The system-level ASEP context this record declares against." ;
    skos:inScheme <https://standards.example/asep> .

asep:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    skos:inScheme <https://standards.example/asep> .

asep:classification a owl:ObjectProperty ;
    rdfs:label "classification" ;
    skos:definition "ASEP 3.2.2. The category and severity assigned against the ex-ante framework." ;
    skos:inScheme <https://standards.example/asep> .

asep:classification_framework a owl:ObjectProperty ;
    rdfs:label "classification_framework" ;
    skos:definition "ASEP 3.2.2. The documented, ex-ante, versioned framework." ;
    skos:inScheme <https://standards.example/asep> .

asep:complexity_domain a owl:ObjectProperty ;
    rdfs:label "complexity_domain" ;
    skos:definition "ASEP 3.3.6. The Cynefin domain that sets escalation tempo and Navigate shape." ;
    skos:inScheme <https://standards.example/asep> .

asep:conflict_engagement a owl:ObjectProperty ;
    rdfs:label "conflict_engagement" ;
    skos:definition "ASEP 3.3.1a. Present for a conflict-class signal; opens an engagement pathway and records a documented exchange before termination." ;
    skos:inScheme <https://standards.example/asep> .

asep:conformance a owl:ObjectProperty ;
    rdfs:label "conformance" ;
    skos:definition "ASEP 2.2. The three invariant answers on the face; no total." ;
    skos:inScheme <https://standards.example/asep> .

asep:coverage_review a owl:DatatypeProperty ;
    rdfs:label "coverage_review" ;
    skos:definition "Subject to periodic coverage review for missing harm classes." ;
    skos:inScheme <https://standards.example/asep> .

asep:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    skos:definition "What happened, stated as observation not evaluation." ;
    skos:inScheme <https://standards.example/asep> .

asep:disposition a owl:ObjectProperty ;
    rdfs:label "disposition" ;
    skos:definition "ASEP 2.2. The terminal disposition (the finite path to decision); a non-adverse judgment is itself recorded." ;
    skos:inScheme <https://standards.example/asep> .

asep:documented_exchange a owl:DatatypeProperty ;
    rdfs:label "documented_exchange" ;
    skos:definition "A documented exchange within the engagement process took place before Navigate terminated the signal." ;
    skos:inScheme <https://standards.example/asep> .

asep:durable a owl:DatatypeProperty ;
    rdfs:label "durable" ;
    skos:inScheme <https://standards.example/asep> .

asep:escalation a owl:ObjectProperty ;
    rdfs:label "escalation" ;
    skos:definition "ASEP 3.3.6. The Signal Escalation state this signal has reached." ;
    skos:inScheme <https://standards.example/asep> .

asep:escalation_architecture_present a owl:DatatypeProperty ;
    rdfs:label "escalation_architecture_present" ;
    skos:definition "ASEP 3.3.6. The Signal Escalation state machine is implemented (required by the checker at Instrumented and above)." ;
    skos:inScheme <https://standards.example/asep> .

asep:ex_ante a owl:DatatypeProperty ;
    rdfs:label "ex_ante" ;
    skos:definition "Defined before specific disputes." ;
    skos:inScheme <https://standards.example/asep> .

asep:ex_ante_criteria a owl:ObjectProperty ;
    rdfs:label "ex_ante_criteria" ;
    skos:inScheme <https://standards.example/asep> .

asep:finding a owl:ObjectProperty ;
    rdfs:label "finding" ;
    skos:inScheme <https://standards.example/asep> .

asep:finite_path_to_decision a owl:ObjectProperty ;
    rdfs:label "finite_path_to_decision" ;
    skos:inScheme <https://standards.example/asep> .

asep:framework_version a owl:DatatypeProperty ;
    rdfs:label "framework_version" ;
    skos:definition "ASEP 2.2. The version of the classification framework in effect at signal generation (ex-ante criteria)." ;
    skos:inScheme <https://standards.example/asep> .

asep:independent_of_evaluated_actors a owl:DatatypeProperty ;
    rdfs:label "independent_of_evaluated_actors" ;
    skos:definition "ASEP 4.3. At least one path is independent of the actors being evaluated (required by the checker at Instrumented and above)." ;
    skos:inScheme <https://standards.example/asep> .

asep:kind a owl:ObjectProperty ;
    rdfs:label "kind" ;
    skos:inScheme <https://standards.example/asep> .

asep:logging a owl:ObjectProperty ;
    rdfs:label "logging" ;
    skos:definition "ASEP 3.2.1, 4.3. The logging paths and their integrity properties." ;
    skos:inScheme <https://standards.example/asep> .

asep:navigate a owl:ObjectProperty ;
    rdfs:label "navigate" ;
    skos:definition "ASEP 3.3. The signal-processing lifecycle, covering time bounds, action, and rationale." ;
    skos:inScheme <https://standards.example/asep> .

asep:no_silent_erasure a owl:ObjectProperty ;
    rdfs:label "no_silent_erasure" ;
    skos:inScheme <https://standards.example/asep> .

asep:non_adverse_judgment_recorded a owl:DatatypeProperty ;
    rdfs:label "non_adverse_judgment_recorded" ;
    skos:definition "ASEP 2.2. If the signal was judged non-adverse, that judgment is itself recorded (no silent erasure)." ;
    skos:inScheme <https://standards.example/asep> .

asep:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    skos:definition "ASEP 3.2.1. The observable description and the when, where, and who-affected log fields." ;
    skos:inScheme <https://standards.example/asep> .

asep:pathway_opened a owl:DatatypeProperty ;
    rdfs:label "pathway_opened" ;
    skos:inScheme <https://standards.example/asep> .

asep:power_context a owl:DatatypeProperty ;
    rdfs:label "power_context" ;
    skos:definition "ASEP 3.2.2. Relative power or dependency, history, and incentives, where salient." ;
    skos:inScheme <https://standards.example/asep> .

asep:reliability_disclosure a owl:DatatypeProperty ;
    rdfs:label "reliability_disclosure" ;
    skos:definition "ASEP 2.3. Disclosure that audit reliability is bounded until the Four Batteries Relational Battery is jointly instrumented." ;
    skos:inScheme <https://standards.example/asep> .

asep:reporter a owl:DatatypeProperty ;
    rdfs:label "reporter" ;
    skos:inScheme <https://standards.example/asep> .

asep:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    skos:inScheme <https://standards.example/asep> .

asep:severity a owl:ObjectProperty ;
    rdfs:label "severity" ;
    skos:inScheme <https://standards.example/asep> .

asep:source a owl:ObjectProperty ;
    rdfs:label "source" ;
    skos:definition "ASEP 3.2.1, 4.2. Who reported the signal and in what role." ;
