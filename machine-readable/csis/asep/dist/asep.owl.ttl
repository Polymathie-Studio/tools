asep:time_to_first_decision a owl:DatatypeProperty ;
    rdfs:label "time_to_first_decision" ;
    skos:definition "ASEP 3.3.1. The recorded first decision against the per-severity bound." ;
    skos:inScheme <https://standards.example/asep> .

asep:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition "ASEP 2.2. Versioned, defined ex-ante." ;
    skos:inScheme <https://standards.example/asep> .

asep:when a owl:DatatypeProperty ;
    rdfs:label "when" ;
    skos:inScheme <https://standards.example/asep> .

asep:where a owl:DatatypeProperty ;
    rdfs:label "where" ;
    skos:inScheme <https://standards.example/asep> .

