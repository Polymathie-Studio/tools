@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scls: <https://standards.example/scls/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://standards.example/scls.owl.ttl> a owl:Ontology ;
    rdfs:label "scls" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "SCLS structural consent record" ;
    skos:definition """The one canonical source for the machine-readable layer of the Structural Consent Legibility Standard (standards-3_0-structural-consent, v0.3.25): a LinkML model of the shape a consent-bearing action's record must carry to be structurally legible. SCLS is a relational-predicate standard, so the tree root is a per-action ConsentRecord whose core is the relational predicates (who acts, who benefits, who bears cost, who is affected), and the system-level obligations are a ConsentArchitecture the record declares its context against. Every machine-readable artifact in dist/ is generated from this file.
The structural obligations (which relations and exposures must be present) are modeled here. The interpretive obligations are NOT schema-expressible and belong to the conformance checker: whether consent is genuine rather than hollow (the standard states its own surface cannot tell them apart under relational depletion, Section 6), whether a description is evaluable by the constituency, whether an exit cost is punitive, and the bandwidth sufficiency judgment. scls-register.yaml marks each requirement shape, judgment, or mixed.
Tier-gating (which obligations bind at Assessed, Operational, Instrumented, Loop-Closed, or Auditable) is enforced by the checker against the register's per-entry tier field, not by this schema, so the schema models the full shape with tier-gated blocks optional rather than encoding enum-precondition rules (the known silent-failure mode).""" .

scls:ConsentRecord a owl:Class ;
    rdfs:label "ConsentRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom scls:NegotiatedLimit ;
            owl:onProperty scls:negotiated_limits ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:cost_bearing_party ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:Verification ;
            owl:onProperty scls:verification ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:Authorization ;
            owl:onProperty scls:authorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConsentDomain ;
            owl:onProperty scls:domains_touched ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:wheel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:verification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:conformance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:authorization ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:affected_constituency ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:WheelAxes ;
            owl:onProperty scls:wheel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:action ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:cost_bearing_party ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:withdrawal ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:Action ;
            owl:onProperty scls:action ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:Withdrawal ;
            owl:onProperty scls:withdrawal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:domains_touched ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConsentArchitecture ;
            owl:onProperty scls:architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:AffectedConstituency ;
            owl:onProperty scls:affected_constituency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:authorization ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:withdrawal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:conformance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:CostBearingParty ;
            owl:onProperty scls:cost_bearing_party ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:wheel ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:verification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:negotiated_limits ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:action ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:affected_constituency ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConformanceDeclaration ;
            owl:onProperty scls:conformance ] ;
    skos:definition "A per-action consent record. Carries the relational predicates and the invariant exposures (Identify, Authorize, Verify) on its face, and declares the system context it was produced under." ;
    skos:inScheme <https://standards.example/scls> .

scls:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:specification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:category_level ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:category_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:trigger_condition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:specification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:trigger_condition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:specification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:trigger_condition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:category_level ] ;
    skos:definition "SCLS 3.1. The specified action; a category-level authorization names the trigger condition that requires a standing evaluation before a specific action proceeds." ;
    skos:inScheme <https://standards.example/scls> .

scls:AffectedConstituency a owl:Class ;
    rdfs:label "AffectedConstituency" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:identification_basis ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:identified_before_action ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:identified_before_action ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:identification_basis ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:identified_before_action ] ;
    skos:definition "SCLS 3.1, 3.1.1. The materially-affected set, identified before the action, on an evidence-and-self-identification basis." ;
    skos:inScheme <https://standards.example/scls> .

scls:Authorization a owl:Class ;
    rdfs:label "Authorization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:response_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ResponseStatus ;
            owl:onProperty scls:response_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:SystemObligations ;
            owl:onProperty scls:system_obligations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:system_obligations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:authorizing_set ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:authorizing_set ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:system_obligations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:response_status ] ;
    skos:definition "SCLS 3.2, 6.1. A meaningful opportunity to authorize or refuse, the four system obligations, and the response-status distinction." ;
    skos:inScheme <https://standards.example/scls> .

scls:ConformanceDeclaration a owl:Class ;
    rdfs:label "ConformanceDeclaration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:cost_bearer_identified ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:authorize_satisfied ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:authorize_satisfied ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:identify_satisfied ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConformanceAnswer ;
            owl:onProperty scls:identify_satisfied ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConformanceAnswer ;
            owl:onProperty scls:verify_satisfied ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:verify_satisfied ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:verify_satisfied ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:identify_satisfied ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConformanceAnswer ;
            owl:onProperty scls:cost_bearer_identified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:cost_bearer_identified ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConformanceAnswer ;
            owl:onProperty scls:authorize_satisfied ] ;
    skos:definition "SCLS. The invariant conformance answers on the face. There is deliberately no overall or total field: conformance is per-invariant, mirroring the suite's refusal to collapse a profile into a single number and the SLSA Verification-Summary-Attestation shape." ;
    skos:inScheme <https://standards.example/scls> .

scls:ConsentArchitecture a owl:Class ;
    rdfs:label "ConsentArchitecture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom scls:AdoptionTier ;
            owl:onProperty scls:adopted_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:adopted_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:adopted_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:durable_constituency_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:StandingEvaluation ;
            owl:onProperty scls:standing_evaluation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:domains_applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:DetectionArchitecture ;
            owl:onProperty scls:detection_architecture ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:DurableConstituencyDefinition ;
            owl:onProperty scls:durable_constituency_definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:detection_architecture ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:standing_evaluation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:external_override_disclosure ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ExternalOverrideDisclosure ;
            owl:onProperty scls:external_override_disclosure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:external_override_disclosure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:durable_constituency_definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ConsentDomain ;
            owl:onProperty scls:domains_applicable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:detection_architecture ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:standing_evaluation ] ;
    skos:definition "SCLS system-level context. Which domains apply, the adopted tier, the durable constituency definition, the external-override disclosure, and the higher-tier blocks (standing evaluation, detection architecture) that a record declares its context against. The higher-tier blocks are optional in the schema; the checker requires them at the tiers the register specifies." ;
    skos:inScheme <https://standards.example/scls> .

scls:CostBearingParty a owl:Class ;
    rdfs:label "CostBearingParty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:consent_to_cost_distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:consent_to_cost_distribution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:identity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:identity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:identity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:consent_to_cost_distribution ] ;
    skos:definition "SCLS 2.1. A cost-bearer distinct from the acting and benefiting parties; identified explicitly with consent to the cost distribution obtained before the action." ;
    skos:inScheme <https://standards.example/scls> .

scls:DetectionArchitecture a owl:Class ;
    rdfs:label "DetectionArchitecture" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:transparent_to_participants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:transparent_to_participants ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:transparent_to_participants ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:shadow_detections ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ShadowDetection ;
            owl:onProperty scls:shadow_detections ] ;
    skos:definition "SCLS 5.3.1. Per shadow type, a graduated detection with a monitoring and an escalation threshold; flags for Signal Escalation, never adjudicates." ;
    skos:inScheme <https://standards.example/scls> .

scls:DurableConstituencyDefinition a owl:Class ;
    rdfs:label "DurableConstituencyDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:accessible_without_authority_gating ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:independent_observer_determinable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:independent_observer_determinable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:independent_observer_determinable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:accessible_without_authority_gating ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:accessible_without_authority_gating ] ;
    skos:definition "SCLS 3.1.2. The durable, accessible definition of who holds participation rights." ;
    skos:inScheme <https://standards.example/scls> .

scls:ExternalOverrideDisclosure a owl:Class ;
    rdfs:label "ExternalOverrideDisclosure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:jurisdictions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:jurisdictions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:gap_treatment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:gap_treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:gap_treatment ] ;
    skos:definition "SCLS 2.3.2. The disclosure whose absence is a consent legibility failure." ;
    skos:inScheme <https://standards.example/scls> .

scls:NegotiatedLimit a owl:Class ;
    rdfs:label "NegotiatedLimit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:limit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:limit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:limit ] ;
    skos:inScheme <https://standards.example/scls> .

scls:ShadowDetection a owl:Class ;
    rdfs:label "ShadowDetection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:shadow_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom scls:ShadowType ;
            owl:onProperty scls:shadow_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:monitoring_threshold ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:escalation_threshold ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:monitoring_threshold ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:escalation_threshold ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:shadow_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:escalation_threshold ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:monitoring_threshold ] ;
    skos:definition "SCLS 5.3.1. One shadow type's graduated detection." ;
    skos:inScheme <https://standards.example/scls> .

scls:StandingEvaluation a owl:Class ;
    rdfs:label "StandingEvaluation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:evidence_backed_evaluation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:evidence_backed_evaluation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:evidence_backed_evaluation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:distributed_evaluation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:self_identification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:implausible_absence_detection ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:implausible_absence_detection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:self_identification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:implausible_absence_detection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:distributed_evaluation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:distributed_evaluation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:self_identification ] ;
    skos:definition "SCLS 3.1.1. The four elements, none concentrated in a single actor." ;
    skos:inScheme <https://standards.example/scls> .

scls:SystemObligations a owl:Class ;
    rdfs:label "SystemObligations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:support ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:exit_or_objection_cost_not_punitive ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:exit_or_objection_cost_not_punitive ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:support ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:legibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:legibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:legibility ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:support ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:exit_or_objection_cost_not_punitive ] ;
    skos:definition "SCLS 6.1. The four obligations are on the system, not the participant. Presence is shape; the qualitative reads (is the description evaluable, is the exit cost punitive) are checked." ;
    skos:inScheme <https://standards.example/scls> .

scls:Verification a owl:Class ;
    rdfs:label "Verification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:tamper_evident ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_benefited ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:durable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_was_affected ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_acted ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:agreed_limits ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:tamper_evident ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_bears_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:durable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:agreed_limits ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:tamper_evident ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_benefited ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_acted ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_was_affected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_acted ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_was_affected ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_bears_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_bears_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_benefited ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:durable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:agreed_limits ] ;
    skos:definition "SCLS 3.3. The consent record's completeness and durability." ;
    skos:inScheme <https://standards.example/scls> .

scls:WheelAxes a owl:Class ;
    rdfs:label "WheelAxes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_acts ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty scls:both_legible_to_both_parties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_benefits ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:who_benefits ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_acts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:who_benefits ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:who_acts ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:both_legible_to_both_parties ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:both_legible_to_both_parties ] ;
    skos:definition "SCLS 2.1, 3.2. The two independent axes, both legible to both parties (2.3.1 bidirectional awareness)." ;
    skos:inScheme <https://standards.example/scls> .

scls:Withdrawal a owl:Class ;
    rdfs:label "Withdrawal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty scls:structural_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:structural_cost ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty scls:structural_cost ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty scls:mechanism ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty scls:mechanism ] ;
    skos:definition "SCLS 2.3.1. Revocability. Structurally feasible, not merely formally permitted." ;
    skos:inScheme <https://standards.example/scls> .

<https://standards.example/scls/AdoptionTier#assessed> a owl:Class ;
    rdfs:label "assessed" ;
    rdfs:subClassOf scls:AdoptionTier .

<https://standards.example/scls/AdoptionTier#auditable> a owl:Class ;
    rdfs:label "auditable" ;
    rdfs:subClassOf scls:AdoptionTier .

