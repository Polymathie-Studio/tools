    rdfs:label "instrumented" ;
    rdfs:subClassOf scls:AdoptionTier .

<https://standards.example/scls/AdoptionTier#loop_closed> a owl:Class ;
    rdfs:label "loop_closed" ;
    rdfs:subClassOf scls:AdoptionTier .

<https://standards.example/scls/AdoptionTier#operational> a owl:Class ;
    rdfs:label "operational" ;
    rdfs:subClassOf scls:AdoptionTier .

<https://standards.example/scls/ConformanceAnswer#declared_absent_with_justification> a owl:Class ;
    rdfs:label "declared_absent_with_justification" ;
    rdfs:subClassOf scls:ConformanceAnswer .

<https://standards.example/scls/ConformanceAnswer#not_applicable> a owl:Class ;
    rdfs:label "not_applicable" ;
    rdfs:subClassOf scls:ConformanceAnswer .

<https://standards.example/scls/ConformanceAnswer#satisfied> a owl:Class ;
    rdfs:label "satisfied" ;
    rdfs:subClassOf scls:ConformanceAnswer .

<https://standards.example/scls/ConsentDomain#coordination> a owl:Class ;
    rdfs:label "coordination" ;
    rdfs:subClassOf scls:ConsentDomain .

<https://standards.example/scls/ConsentDomain#data> a owl:Class ;
    rdfs:label "data" ;
    rdfs:subClassOf scls:ConsentDomain .

<https://standards.example/scls/ConsentDomain#observation> a owl:Class ;
    rdfs:label "observation" ;
    rdfs:subClassOf scls:ConsentDomain .

<https://standards.example/scls/ConsentDomain#output> a owl:Class ;
    rdfs:label "output" ;
    rdfs:subClassOf scls:ConsentDomain .

<https://standards.example/scls/ConsentDomain#participation> a owl:Class ;
    rdfs:label "participation" ;
    rdfs:subClassOf scls:ConsentDomain .

<https://standards.example/scls/ResponseStatus#authorized> a owl:Class ;
