@prefix asep: <https://standards.example/asep/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

asep:AdverseSignalRecord a sh:NodeShape ;
    rdfs:comment "One adverse signal carried through Notice, Name, and Navigate, with its escalation state and terminal disposition on the face." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class asep:Disposition ;
            sh:description "ASEP 2.2. The terminal disposition (the finite path to decision); a non-adverse judgment is itself recorded." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path asep:disposition ],
        [ sh:class asep:Observation ;
            sh:description "ASEP 3.2.1. The observable description and the when, where, and who-affected log fields." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path asep:observation ],
        [ sh:class asep:ASEPArchitecture ;
            sh:description "The system-level ASEP context this record declares against." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path asep:architecture ],
        [ sh:class asep:EscalationState ;
            sh:description "ASEP 3.3.6. The Signal Escalation state this signal has reached." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path asep:escalation ],
        [ sh:class asep:Source ;
            sh:description "ASEP 3.2.1, 4.2. Who reported the signal and in what role." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path asep:source ],
        [ sh:class asep:Classification ;
            sh:description "ASEP 3.2.2. The category and severity assigned against the ex-ante framework." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path asep:classification ],
        [ sh:class asep:ConformanceDeclaration ;
            sh:description "ASEP 2.2. The three invariant answers on the face; no total." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path asep:conformance ],
        [ sh:class asep:Navigate ;
            sh:description "ASEP 3.3. The signal-processing lifecycle, covering time bounds, action, and rationale." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path asep:navigate ] ;
    sh:targetClass asep:AdverseSignalRecord .

asep:ASEPArchitecture a sh:NodeShape ;
    rdfs:comment "The system-level ASEP context. Higher-tier blocks are optional in the schema; the checker requires them at the tiers the register specifies." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "ASEP 4.1. Explicit anti-retaliation commitment (required by the checker at Instrumented and above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path asep:anti_retaliation_policy ],
        [ sh:class asep:LoggingPaths ;
            sh:description "ASEP 3.2.1, 4.3. The logging paths and their integrity properties." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path asep:logging ],
        [ sh:datatype xsd:boolean ;
            sh:description "ASEP 2.3. Disclosure that audit reliability is bounded until the Four Batteries Relational Battery is jointly instrumented." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path asep:reliability_disclosure ],
        [ sh:datatype xsd:boolean ;
            sh:description "ASEP 3.3.6. The Signal Escalation state machine is implemented (required by the checker at Instrumented and above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path asep:escalation_architecture_present ],
        [ sh:class asep:ClassificationFramework ;
            sh:description "ASEP 3.2.2. The documented, ex-ante, versioned framework." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path asep:classification_framework ],
        [ sh:in ( "assessed" "operational" "instrumented" "loop_closed" "auditable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path asep:adopted_tier ] ;
    sh:targetClass asep:ASEPArchitecture .

asep:Classification a sh:NodeShape ;
    rdfs:comment "ASEP 3.2.2. Category and severity assigned against the ex-ante versioned framework." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "low" "medium" "high" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path asep:severity ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 2.2. The version of the classification framework in effect at signal generation (ex-ante criteria)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path asep:framework_version ],
        [ sh:description "ASEP 3.3.6. The Cynefin domain that sets escalation tempo and Navigate shape." ;
            sh:in ( "clear" "complicated" "complex" "chaotic" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path asep:complexity_domain ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:category ] ;
    sh:targetClass asep:Classification .

asep:ClassificationFramework a sh:NodeShape ;
    rdfs:comment "ASEP 3.2.2. The adverse-signal categories and severity levels." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Defined before specific disputes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:ex_ante ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 2.2. Versioned, defined ex-ante." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:version ],
        [ sh:datatype xsd:boolean ;
            sh:description "Subject to periodic coverage review for missing harm classes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path asep:coverage_review ] ;
    sh:targetClass asep:ClassificationFramework .

asep:ConflictEngagement a sh:NodeShape ;
    rdfs:comment "ASEP 3.3.1a. The engagement pathway for a conflict-class signal." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:pathway_opened ],
        [ sh:datatype xsd:boolean ;
            sh:description "A documented exchange within the engagement process took place before Navigate terminated the signal." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:documented_exchange ] ;
    sh:targetClass asep:ConflictEngagement .

asep:ConformanceDeclaration a sh:NodeShape ;
    rdfs:comment "ASEP 2.2. The three invariant answers on the face. There is deliberately no overall or total field: conformance is per-invariant, mirroring the suite's refusal to collapse a profile into a single number." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path asep:no_silent_erasure ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path asep:finite_path_to_decision ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path asep:ex_ante_criteria ] ;
    sh:targetClass asep:ConformanceDeclaration .

asep:Disposition a sh:NodeShape ;
    rdfs:comment "ASEP 2.2. The terminal disposition on the finite path to decision." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:rationale ],
        [ sh:datatype xsd:boolean ;
            sh:description "ASEP 2.2. If the signal was judged non-adverse, that judgment is itself recorded (no silent erasure)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path asep:non_adverse_judgment_recorded ],
        [ sh:in ( "act" "monitor" "close" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path asep:kind ] ;
    sh:targetClass asep:Disposition .

asep:EscalationState a sh:NodeShape ;
    rdfs:comment "ASEP 3.3.6. The time-governed Signal Escalation stage, driven by elapsed time not human initiative." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "generated" "acknowledged" "auto_escalated" "obligation_triggered" "terminal_visibility" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path asep:stage ],
        [ sh:datatype xsd:boolean ;
            sh:description "ASEP 3.3.6. The window length was published before it began running (window validity)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path asep:window_pre_specified ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 3.3.6. The maximum elapsed time from generation to first acknowledgment, pre-specified." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:acknowledgment_window ] ;
    sh:targetClass asep:EscalationState .

asep:LoggingPaths a sh:NodeShape ;
    rdfs:comment "ASEP 3.2.1, 4.3. Durability and independence of the logs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:tamper_evident ],
        [ sh:datatype xsd:boolean ;
            sh:description "ASEP 4.3. At least one path is independent of the actors being evaluated (required by the checker at Instrumented and above)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path asep:independent_of_evaluated_actors ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:durable ] ;
    sh:targetClass asep:LoggingPaths .

asep:Navigate a sh:NodeShape ;
    rdfs:comment "ASEP 3.3. The signal-processing lifecycle from assessment through decision." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "ASEP 3.3.1. The recorded first decision against the per-severity bound." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:time_to_first_decision ],
        [ sh:class asep:ConflictEngagement ;
            sh:description "ASEP 3.3.1a. Present for a conflict-class signal; opens an engagement pathway and records a documented exchange before termination." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path asep:conflict_engagement ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 3.3.1. The documented basis for the decision." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path asep:rationale ],
        [ sh:class asep:RootCauseFinding ;
            sh:description "ASEP 3.3.3. Present when a pattern threshold triggered reclassification; one of the three named findings." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path asep:structural_root_cause_finding ],
        [ sh:description "ASEP 3.3.1. The action chosen from the bounded set." ;
            sh:in ( "mitigate_or_contain" "escalate" "initiate_engagement" "monitor" "close" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path asep:action ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 3.3.1. The recorded first substantive look against the per-severity bound." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:time_to_assessment ] ;
    sh:targetClass asep:Navigate .

asep:Observation a sh:NodeShape ;
    rdfs:comment "ASEP 3.2.1. The durable log entry, observation separated from evaluation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path asep:who_affected ],
        [ sh:datatype xsd:string ;
            sh:description "ASEP 3.2.2. Relative power or dependency, history, and incentives, where salient." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path asep:power_context ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:when ],
        [ sh:datatype xsd:string ;
            sh:description "What happened, stated as observation not evaluation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path asep:where ] ;
    sh:targetClass asep:Observation .

asep:RootCauseFinding a sh:NodeShape ;
    rdfs:comment "ASEP 3.3.3. The structural root cause assessment finding." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "no_structural_condition" "structural_condition_identified" "insufficient_information" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path asep:finding ] ;
    sh:targetClass asep:RootCauseFinding .

asep:Source a sh:NodeShape ;
    rdfs:comment "ASEP 3.2.1, 4.2. Any actor may log a signal that meets minimal criteria." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path asep:reporter ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path asep:role ] ;
    sh:targetClass asep:Source .


