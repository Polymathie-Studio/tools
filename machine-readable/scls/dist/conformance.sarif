{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "scls-conformance",
          "version": "0.3.25",
          "rules": [
            {
              "id": "identify_satisfied",
              "shortDescription": {
                "text": "SCLS Identify invariant (3.1) satisfied on the face"
              }
            },
            {
              "id": "authorize_satisfied",
              "shortDescription": {
                "text": "SCLS Authorize invariant (3.2) satisfied on the face"
              }
            },
            {
              "id": "verify_satisfied",
              "shortDescription": {
                "text": "SCLS Verify invariant (3.3) satisfied on the face"
              }
            },
            {
              "id": "cost_bearer_identified",
              "shortDescription": {
                "text": "SCLS 2.1 cost-bearing party identified with consent to the cost distribution"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "identify_satisfied",
          "level": "none",
          "message": {
            "text": "SCLS Identify invariant (3.1) satisfied on the face: satisfied"
          }
        },
        {
          "ruleId": "authorize_satisfied",
          "level": "none",
          "message": {
            "text": "SCLS Authorize invariant (3.2) satisfied on the face: satisfied"
          }
        },
        {
          "ruleId": "verify_satisfied",
          "level": "none",
          "message": {
            "text": "SCLS Verify invariant (3.3) satisfied on the face: satisfied"
          }
        },
        {
          "ruleId": "cost_bearer_identified",
          "level": "none",
          "message": {
            "text": "SCLS 2.1 cost-bearing party identified with consent to the cost distribution: satisfied"
          }
        }
      ]
    }
  ]
}
