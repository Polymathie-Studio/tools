            {
              "id": "criterion_intent_status",
              "shortDescription": {
                "text": "WALKRI.3.1 criterion intent: a measurement claim distinct from the label"
              }
            },
            {
              "id": "operational_definition_status",
              "shortDescription": {
                "text": "WALKRI.3.2 operational definition: each category defined with qualifying and non-qualifying examples"
              }
            },
            {
              "id": "response_form_status",
              "shortDescription": {
                "text": "WALKRI.3.3 response form: response type justified against the required variance"
              }
            },
            {
              "id": "evidence_form_status",
              "shortDescription": {
                "text": "WALKRI.3.4 evidence form: evidence type, required content, and independent access path"
              }
            },
            {
              "id": "conformance_threshold_status",
              "shortDescription": {
                "text": "WALKRI.3.5 conformance threshold: applicable components, evidence, and minimum passage threshold"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "criterion_intent_status",
