          "level": "none",
          "message": {
            "text": "WALKRI.3.3 response form: response type justified against the required variance: pass"
          }
        },
        {
          "ruleId": "evidence_form_status",
          "level": "none",
          "message": {
            "text": "WALKRI.3.4 evidence form: evidence type, required content, and independent access path: pass"
