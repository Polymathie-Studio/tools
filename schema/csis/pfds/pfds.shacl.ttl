@prefix pfds: <https://standards.example/pfds/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pfds:PrecisionReview a sh:NodeShape ;
    rdfs:comment "A review of a governed artifact against the invariant, the ten corollaries, congruence, and the failure taxonomy, producing a deficit map." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class pfds:FailurePattern ;
            sh:description "Section 7. The precision-failure patterns, each a structured signature-and-response; the standard's fixed reference set, carried optionally for the same reason as the corollaries." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path pfds:failure_patterns ],
        [ sh:class pfds:Corollary ;
            sh:description "Section 2. The ten corollaries, each a structured precision condition with its two failure directions. These are the standard's fixed reference set, identical across reviews, so a review MAY carry them for self-containment but is not required to restate them; requiring them would be the imposition the corollaries themselves forbid." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path pfds:corollaries ],
        [ sh:class pfds:ConformanceDeclaration ;
            sh:description "The invariant answers on the face; no total." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path pfds:conformance ],
        [ sh:in ( "assessed" "operational" "instrumented" "loop_closed" "auditable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pfds:obligation_tier ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 3. Method-Structure Congruence was assessed for the artifact's production." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path pfds:congruence_checked ],
        [ sh:description "Section 6.1. The depth of the review (auditing, remediation, design-time)." ;
            sh:in ( "auditing" "remediation" "design_time" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pfds:adoption_depth ],
        [ sh:datatype xsd:string ;
            sh:description "The governed artifact under review." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pfds:subject ],
        [ sh:class pfds:PrecisionDeficit ;
            sh:description "Section 6.1. The precision deficit map, each deficit located and keyed to a failure pattern." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path pfds:deficits ] ;
    sh:targetClass pfds:PrecisionReview .

pfds:ConformanceDeclaration a sh:NodeShape ;
    rdfs:comment "The invariant answers on the face. There is deliberately no overall or total field: conformance is per-condition, mirroring the suite's refusal to collapse a profile into a single number." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path pfds:method_structure_congruent ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path pfds:violations_detectable ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path pfds:compliance_serves_purpose ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path pfds:deficits_mapped ] ;
    sh:targetClass pfds:ConformanceDeclaration .

pfds:Corollary a sh:NodeShape ;
    rdfs:comment "Section 2. One precision corollary, individuated by its condition and its two failure directions (a deficit and an imposition), not by a label. A corollary with no directions is not a corollary, so condition, deficit_direction, and imposition_direction are required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pfds:name ],
        [ sh:datatype xsd:string ;
            sh:description "The corrective exemplar the standard cites." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path pfds:corrective ],
        [ sh:datatype xsd:string ;
            sh:description "What over-specification produces." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path pfds:imposition_direction ],
        [ sh:datatype xsd:string ;
            sh:description "What under-specification fails to prevent." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pfds:deficit_direction ],
        [ sh:datatype xsd:string ;
            sh:description "The corollary handle (for example operational_definition, taxonomy_completeness)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pfds:id ],
        [ sh:datatype xsd:string ;
            sh:description "The iff condition the corollary specifies." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pfds:condition ] ;
    sh:targetClass pfds:Corollary .

pfds:FailurePattern a sh:NodeShape ;
    rdfs:comment "Section 7. One precision-failure pattern, individuated by its structural signature and its response. A pattern with no signature is a label, so signature and response are required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The observable signature that identifies the pattern." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pfds:structural_signature ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pfds:name ],
        [ sh:datatype xsd:string ;
            sh:description "The pattern handle (for example normative_substitution, category_collapse)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pfds:id ],
        [ sh:datatype xsd:string ;
            sh:description "The response the pattern enables." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path pfds:response ] ;
    sh:targetClass pfds:FailurePattern .

pfds:PrecisionDeficit a sh:NodeShape ;
    rdfs:comment "Section 6.1. One entry in the precision deficit map." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The document and location of the deficit." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path pfds:location ],
        [ sh:datatype xsd:string ;
            sh:description "The failure-pattern handle the deficit is keyed to." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path pfds:pattern ],
        [ sh:datatype xsd:string ;
            sh:description "Section 6.5. The documented decision (remediation, acceptance with rationale, deferral, or not-a-deficit); required at Loop-Closed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path pfds:decision ] ;
    sh:targetClass pfds:PrecisionDeficit .


