@prefix cts: <https://standards.example/cts/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://standards.example/cts.owl.ttl> a owl:Ontology ;
    rdfs:label "cts" ;
    dcterms:license "CC-BY-4.0" ;
    dcterms:title "CTS conflict transformation record" ;
    skos:definition """The one canonical source for the machine-readable layer of the Conflict Transformation Standard (standards-3_0-conflict-transformation, v0.2.10), the third Tensegrity Generative Standard. CTS specifies enabling conditions through five structural invariants, each individuated by its own satisfaction test, signatures, and epistemic tier, so the model renders them as typed StructuralInvariant objects rather than a flat enum of invariant names. Rendering the invariants as bare labels would collapse the structure into names, a precision deficit under the Precision-First Design Standard whose absent structure leaves no gap marker; the structural rendering is deliberate.
The tree root is a ConflictTransformationRecord, a coordination system's declaration of its conflict-transformation capacity: whether the constitutional pre-condition is established, the five invariants each with its satisfaction status and epistemic tier, the operational scales addressed, the adoption tier, and per-invariant conformance. Being a generative standard, CTS names capacity conditions rather than floors that reject an artifact; whether a system satisfies an invariant is largely judgment against the structural satisfaction test and routes to the checker, while a few signatures (the proactive-disposition ratio, implausible absence of conflict events) are computable. Every artifact in dist/ is generated from this file.""" .

cts:ConflictTransformationRecord a owl:Class ;
    rdfs:label "ConflictTransformationRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:adoption_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:invariants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:constitutional_precondition_established ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:StructuralInvariant ;
            owl:onProperty cts:invariants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:conformance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:AdoptionTier ;
            owl:onProperty cts:adoption_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:constitutional_precondition_established ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:OperationalScale ;
            owl:onProperty cts:scales_addressed ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:conformance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cts:constitutional_precondition_established ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:adoption_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:subject ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceDeclaration ;
            owl:onProperty cts:conformance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cts:subject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cts:scales_addressed ] ;
    skos:definition "A coordination system's declaration of its conflict-transformation capacity across the five invariants, the scales it addresses, and its adoption tier." ;
    skos:inScheme <https://standards.example/cts> .

cts:ConformanceDeclaration a owl:Class ;
    rdfs:label "ConformanceDeclaration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceAnswer ;
            owl:onProperty cts:graduated_architecture_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:transformation_capacity_provisioned ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:conflict_legible ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:transformation_capacity_provisioned ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:proactive_disposition_protected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:engagement_recognized ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceAnswer ;
            owl:onProperty cts:transformation_capacity_provisioned ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceAnswer ;
            owl:onProperty cts:engagement_recognized ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:conflict_legible ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:engagement_recognized ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:graduated_architecture_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:proactive_disposition_protected ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceAnswer ;
            owl:onProperty cts:conflict_legible ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:graduated_architecture_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:ConformanceAnswer ;
            owl:onProperty cts:proactive_disposition_protected ] ;
    skos:definition "The per-invariant conformance answers. There is deliberately no overall or total field: conformance is per-invariant, mirroring the suite's refusal to collapse a profile into a single number." ;
    skos:inScheme <https://standards.example/cts> .

cts:StructuralInvariant a owl:Class ;
    rdfs:label "StructuralInvariant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cts:signature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:EpistemicTier ;
            owl:onProperty cts:epistemic_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cts:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cts:satisfaction_test ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:satisfaction_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:satisfaction_test ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:epistemic_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:satisfaction_test ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cts:signature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:signature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cts:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cts:SatisfactionStatus ;
            owl:onProperty cts:satisfaction_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:satisfaction_status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cts:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cts:epistemic_tier ] ;
    skos:definition "Section 4. One of the five structural invariants, individuated by its satisfaction test and its epistemic tier, not by a label. An invariant with no satisfaction test is a name, so satisfaction_test, satisfaction_status, and epistemic_tier are required." ;
    skos:inScheme <https://standards.example/cts> .

<https://standards.example/cts/AdoptionTier#auditable> a owl:Class ;
    rdfs:label "auditable" ;
    rdfs:subClassOf cts:AdoptionTier .

<https://standards.example/cts/AdoptionTier#declared> a owl:Class ;
    rdfs:label "declared" ;
    rdfs:subClassOf cts:AdoptionTier .

<https://standards.example/cts/AdoptionTier#instrumented> a owl:Class ;
    rdfs:label "instrumented" ;
    rdfs:subClassOf cts:AdoptionTier .

<https://standards.example/cts/AdoptionTier#loop_closed> a owl:Class ;
    rdfs:label "loop_closed" ;
    rdfs:subClassOf cts:AdoptionTier .

<https://standards.example/cts/AdoptionTier#structured> a owl:Class ;
    rdfs:label "structured" ;
    rdfs:subClassOf cts:AdoptionTier .

<https://standards.example/cts/ConformanceAnswer#declared_absent_with_justification> a owl:Class ;
    rdfs:label "declared_absent_with_justification" ;
    rdfs:subClassOf cts:ConformanceAnswer .

<https://standards.example/cts/ConformanceAnswer#not_applicable> a owl:Class ;
    rdfs:label "not_applicable" ;
    rdfs:subClassOf cts:ConformanceAnswer .

<https://standards.example/cts/ConformanceAnswer#satisfied> a owl:Class ;
    rdfs:label "satisfied" ;
    rdfs:subClassOf cts:ConformanceAnswer .

<https://standards.example/cts/EpistemicTier#tier_a> a owl:Class ;
    rdfs:label "tier_a" ;
    rdfs:subClassOf cts:EpistemicTier .

<https://standards.example/cts/EpistemicTier#tier_b> a owl:Class ;
    rdfs:label "tier_b" ;
    rdfs:subClassOf cts:EpistemicTier .

<https://standards.example/cts/EpistemicTier#tier_c> a owl:Class ;
    rdfs:label "tier_c" ;
    rdfs:subClassOf cts:EpistemicTier .

<https://standards.example/cts/OperationalScale#inter_organizational> a owl:Class ;
    rdfs:label "inter_organizational" ;
    rdfs:subClassOf cts:OperationalScale .

<https://standards.example/cts/OperationalScale#intra_organizational> a owl:Class ;
    rdfs:label "intra_organizational" ;
    rdfs:subClassOf cts:OperationalScale .

<https://standards.example/cts/OperationalScale#platform_level> a owl:Class ;
    rdfs:label "platform_level" ;
    rdfs:subClassOf cts:OperationalScale .

<https://standards.example/cts/SatisfactionStatus#not_applicable> a owl:Class ;
    rdfs:label "not_applicable" ;
    rdfs:subClassOf cts:SatisfactionStatus .

<https://standards.example/cts/SatisfactionStatus#partial> a owl:Class ;
    rdfs:label "partial" ;
    rdfs:subClassOf cts:SatisfactionStatus .

<https://standards.example/cts/SatisfactionStatus#satisfied> a owl:Class ;
    rdfs:label "satisfied" ;
    rdfs:subClassOf cts:SatisfactionStatus .

<https://standards.example/cts/SatisfactionStatus#violated> a owl:Class ;
    rdfs:label "violated" ;
    rdfs:subClassOf cts:SatisfactionStatus .

cts:invariants a owl:ObjectProperty ;
    rdfs:label "invariants" ;
    skos:definition "Section 4. The five structural invariants, each rendered as a typed object carrying its satisfaction status and epistemic tier. They are constitutive of a capacity declaration; a record that names no invariants could claim capacity while assessing nothing." ;
    skos:inScheme <https://standards.example/cts> .

cts:scales_addressed a owl:ObjectProperty ;
    rdfs:label "scales_addressed" ;
    skos:definition "Section 5. The operational scales at which the record declares the invariants apply." ;
    skos:inScheme <https://standards.example/cts> .

cts:adoption_tier a owl:ObjectProperty ;
    rdfs:label "adoption_tier" ;
    skos:definition "Section 8. The adoption tier the record supports." ;
    skos:inScheme <https://standards.example/cts> .

cts:conflict_legible a owl:ObjectProperty ;
    rdfs:label "conflict_legible" ;
    skos:inScheme <https://standards.example/cts> .

cts:conformance a owl:ObjectProperty ;
    rdfs:label "conformance" ;
    skos:definition "The per-invariant conformance answers on the face; no total." ;
    skos:inScheme <https://standards.example/cts> .

cts:constitutional_precondition_established a owl:DatatypeProperty ;
    rdfs:label "constitutional_precondition_established" ;
    skos:definition "Section 4. Whether parties share sufficient foundational vocabulary about what the organization is to name what they are in conflict about; if not, the required first engagement is constitutional dialogue, not conflict transformation." ;
    skos:inScheme <https://standards.example/cts> .

cts:engagement_recognized a owl:ObjectProperty ;
    rdfs:label "engagement_recognized" ;
    skos:inScheme <https://standards.example/cts> .

cts:epistemic_tier a owl:ObjectProperty ;
    rdfs:label "epistemic_tier" ;
    skos:definition "Section 4. The invariant's epistemic tier (A structural, B literature-plus-structural, C measurement-calibration)." ;
    skos:inScheme <https://standards.example/cts> .

cts:graduated_architecture_present a owl:ObjectProperty ;
    rdfs:label "graduated_architecture_present" ;
    skos:inScheme <https://standards.example/cts> .

cts:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    skos:definition "The invariant handle (for example legibility, graduated_engagement, proactive_disposition, capacity_provision, recognition)." ;
    skos:inScheme <https://standards.example/cts> .

cts:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:inScheme <https://standards.example/cts> .

cts:proactive_disposition_protected a owl:ObjectProperty ;
    rdfs:label "proactive_disposition_protected" ;
    skos:inScheme <https://standards.example/cts> .

cts:satisfaction_status a owl:ObjectProperty ;
    rdfs:label "satisfaction_status" ;
    skos:inScheme <https://standards.example/cts> .

cts:satisfaction_test a owl:DatatypeProperty ;
    rdfs:label "satisfaction_test" ;
    skos:definition "The structural test that determines whether the invariant is satisfied, stated so an independent observer can apply it." ;
    skos:inScheme <https://standards.example/cts> .

cts:signature a owl:DatatypeProperty ;
    rdfs:label "signature" ;
    skos:definition "The observed violation or satisfaction signature supporting the status; some signatures are computable from the coordination record." ;
    skos:inScheme <https://standards.example/cts> .

cts:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    skos:definition "The coordination system whose conflict-transformation capacity is declared." ;
    skos:inScheme <https://standards.example/cts> .

cts:transformation_capacity_provisioned a owl:ObjectProperty ;
    rdfs:label "transformation_capacity_provisioned" ;
    skos:inScheme <https://standards.example/cts> .

cts:EpistemicTier a owl:Class ;
    rdfs:label "EpistemicTier" ;
    owl:unionOf ( <https://standards.example/cts/EpistemicTier#tier_a> <https://standards.example/cts/EpistemicTier#tier_b> <https://standards.example/cts/EpistemicTier#tier_c> ) ;
    skos:definition "Section 4. The three epistemic tiers." ;
    skos:inScheme <https://standards.example/cts> ;
    linkml:permissible_values <https://standards.example/cts/EpistemicTier#tier_a>,
        <https://standards.example/cts/EpistemicTier#tier_b>,
        <https://standards.example/cts/EpistemicTier#tier_c> .

cts:OperationalScale a owl:Class ;
    rdfs:label "OperationalScale" ;
    owl:unionOf ( <https://standards.example/cts/OperationalScale#intra_organizational> <https://standards.example/cts/OperationalScale#inter_organizational> <https://standards.example/cts/OperationalScale#platform_level> ) ;
    skos:definition "Section 5. The three operational scales." ;
    skos:inScheme <https://standards.example/cts> ;
    linkml:permissible_values <https://standards.example/cts/OperationalScale#inter_organizational>,
        <https://standards.example/cts/OperationalScale#intra_organizational>,
        <https://standards.example/cts/OperationalScale#platform_level> .

cts:SatisfactionStatus a owl:Class ;
    rdfs:label "SatisfactionStatus" ;
    owl:unionOf ( <https://standards.example/cts/SatisfactionStatus#satisfied> <https://standards.example/cts/SatisfactionStatus#violated> <https://standards.example/cts/SatisfactionStatus#partial> <https://standards.example/cts/SatisfactionStatus#not_applicable> ) ;
    skos:definition "The status of a structural invariant against the system; silence is not one of the values." ;
    skos:inScheme <https://standards.example/cts> ;
    linkml:permissible_values <https://standards.example/cts/SatisfactionStatus#not_applicable>,
        <https://standards.example/cts/SatisfactionStatus#partial>,
        <https://standards.example/cts/SatisfactionStatus#satisfied>,
        <https://standards.example/cts/SatisfactionStatus#violated> .

cts:AdoptionTier a owl:Class ;
    rdfs:label "AdoptionTier" ;
    owl:unionOf ( <https://standards.example/cts/AdoptionTier#declared> <https://standards.example/cts/AdoptionTier#structured> <https://standards.example/cts/AdoptionTier#instrumented> <https://standards.example/cts/AdoptionTier#loop_closed> <https://standards.example/cts/AdoptionTier#auditable> ) ;
    skos:definition "Section 8. The five adoption tiers." ;
    skos:inScheme <https://standards.example/cts> ;
    linkml:permissible_values <https://standards.example/cts/AdoptionTier#auditable>,
        <https://standards.example/cts/AdoptionTier#declared>,
        <https://standards.example/cts/AdoptionTier#instrumented>,
        <https://standards.example/cts/AdoptionTier#loop_closed>,
        <https://standards.example/cts/AdoptionTier#structured> .

cts:ConformanceAnswer a owl:Class ;
    rdfs:label "ConformanceAnswer" ;
    owl:unionOf ( <https://standards.example/cts/ConformanceAnswer#satisfied> <https://standards.example/cts/ConformanceAnswer#declared_absent_with_justification> <https://standards.example/cts/ConformanceAnswer#not_applicable> ) ;
    skos:definition "Per-invariant answer; silence is not one of the values." ;
    skos:inScheme <https://standards.example/cts> ;
    linkml:permissible_values <https://standards.example/cts/ConformanceAnswer#declared_absent_with_justification>,
        <https://standards.example/cts/ConformanceAnswer#not_applicable>,
        <https://standards.example/cts/ConformanceAnswer#satisfied> .


