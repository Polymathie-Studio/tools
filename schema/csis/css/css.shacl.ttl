@prefix css: <https://standards.example/css/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

css:CoordinationScalingRecord a sh:NodeShape ;
    rdfs:comment "A coordination unit's assessment against the scaling standard, from its effective-Radius determination through per-Radius conformance to its adoption level." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class css:RadiusConformance ;
            sh:description "Sections 4 to 9. One entry per crossed Radius, carrying the Radius and the status of its minimum, maximum, and interface conditions. A crossed Radius is present here iff its function break is recorded in the effective-Radius assessment; a record that names a crossed threshold without enumerating its conditions is rejected." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path css:crossed_thresholds ],
        [ sh:datatype xsd:string ;
            sh:description "The coordination unit under assessment (a project, organization, protocol, working group, or agent unit)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path css:subject ],
        [ sh:description "Section 12. The adoption level the record supports." ;
            sh:in ( "assessed" "operational" "instrumented" "loop_closed" "auditable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path css:adoption_level ],
        [ sh:class css:EffectiveRadiusAssessment ;
            sh:description "Section 11. The unit's effective-Radius assessment, determined by which coordination functions have broken." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path css:effective_radius ],
        [ sh:class css:ConformanceDeclaration ;
            sh:description "The scaling conformance answers on the face; no total." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path css:conformance ],
        [ sh:class css:AffectedPartyReach ;
            sh:description "Section 10 (provisional). The affected-party reach-axis assessment, if the unit has made one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path css:reach ] ;
    sh:targetClass css:CoordinationScalingRecord .

css:AffectedPartyReach a sh:NodeShape ;
    rdfs:comment "Section 10 (provisional). The affected-party reach-axis assessment, orthogonal to the Radii. Whether the unit is above its reach ceiling, and if so whether the proxy or guardian channel is present." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Section 10.5. Whether the affected-party constituency is one the unit does not unilaterally define to its convenience." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path css:constituency_not_unilaterally_controlled ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 10.2. Whether the affected population exceeds what the unit can identify and reach through channels it maintains, so its knowledge is impressionistic (the ceiling crossed)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path css:above_reach_ceiling ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 10.4. Above the ceiling, whether a structurally authorized proxy or guardian channel is operative (not disclosure-only). A minimum condition when above the ceiling." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path css:proxy_or_guardian_channel ] ;
    sh:targetClass css:AffectedPartyReach .

css:AggregateFactor a sh:NodeShape ;
    rdfs:comment "Section 2. One named factor contributing to the effective-Radius aggregate, with its assessed value." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The assessed value or level of the factor, as the assessor records it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path css:value ],
        [ sh:datatype xsd:string ;
            sh:description "The factor name (member_count, interaction_quality, shared_context_depth, medium_mix, or a substrate-specific factor)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path css:name ] ;
    sh:targetClass css:AggregateFactor .

css:ConformanceDeclaration a sh:NodeShape ;
    rdfs:comment "The scaling conformance answers on the face. There is deliberately no overall or total field: conformance is per-condition across crossed thresholds, mirroring the suite's refusal to collapse a profile into a single number." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path css:maximum_conditions_absent ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path css:minimum_conditions_present ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path css:sequential_build_respected ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path css:effective_radius_assessed ] ;
    sh:targetClass css:ConformanceDeclaration .

css:CoordinationRadius a sh:NodeShape ;
    rdfs:comment "One Dunbar-scale threshold rendered as a typed structure. Individuated by the coordination function that breaks at it and the attack surface that opens, not by its number alone. The number, the function break, and the attack surface are required; a Radius reduced to its number has dropped the structure that individuates it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The Radius value." ;
            sh:in ( "radius_5" "radius_15" "radius_50" "radius_150" "radius_500" "radius_1500" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path css:radius ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this Radius is provisional in the standard (true for Radius 500 and Radius 1500)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path css:provisional ],
        [ sh:datatype xsd:string ;
            sh:description "The exploitation vector that opens when this threshold is crossed without its minimum conditions." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path css:attack_surface ],
        [ sh:datatype xsd:string ;
            sh:description "The coordination function that breaks at this threshold." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path css:function_break ] ;
    sh:targetClass css:CoordinationRadius .

css:EffectiveRadiusAssessment a sh:NodeShape ;
    rdfs:comment "Section 11. The determination of the unit's effective Radius by the functional breaks, the primary instrument in all contexts, with the numeric Radius derived from them. Carries the aggregate factors as an open set and the nominal-versus-robust distinction." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class css:FunctionBreak ;
            sh:description "Section 11. One entry per assessed coordination function, recording whether it has broken. The set of broken functions determines which thresholds are crossed; this is the operative instrument, not the numeric threshold." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path css:function_breaks ],
        [ sh:description "Section 2. The highest Radius whose minimum conditions would still hold under worst-case single departure of the highest-coordination-weight individual. A gap below the nominal is a fragility finding." ;
            sh:in ( "radius_5" "radius_15" "radius_50" "radius_150" "radius_500" "radius_1500" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path css:robust_effective_radius ],
        [ sh:class css:AggregateFactor ;
            sh:description "Section 2. The factors the effective Radius aggregates, as an open named set (at minimum member count, interaction frequency and quality, shared context depth, and communication medium mix); a consumer on a different scale substrate supplies its own factors here." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path css:aggregate_factors ],
        [ sh:description "Section 2. The effective Radius with full membership present, derived from the function breaks." ;
            sh:in ( "radius_5" "radius_15" "radius_50" "radius_150" "radius_500" "radius_1500" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path css:nominal_effective_radius ],
        [ sh:datatype xsd:string ;
            sh:description "Section 11 (Precision-First Design Standard Corollary 9). A statement of the unit's structural context where it diverges from the research-derived anchor contexts, since the threshold numbers are approximations and the functional questions are primary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path css:contextual_baseline ] ;
    sh:targetClass css:EffectiveRadiusAssessment .

css:FunctionBreak a sh:NodeShape ;
    rdfs:comment "Section 11. One coordination function and whether it has broken at the unit's scale. The function names the observable break; its status carries the assessment. A break with no status is not an assessment, so function and broken are required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the function has broken (the threshold is crossed) or still holds." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path css:broken ],
        [ sh:description "The Radius whose crossing this function's break indicates." ;
            sh:in ( "radius_5" "radius_15" "radius_50" "radius_150" "radius_500" "radius_1500" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path css:radius ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 11. Whether the function is stressed or unreliable while not yet broken, which is threshold approach, not a conformance finding, but a trigger for the next founding window." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path css:approach_noted ],
        [ sh:datatype xsd:string ;
            sh:description "The coordination function assessed (for example state_legibility at Radius 5, sympathy_network at Radius 15, capacity_inventory at Radius 50, reputation_norm_response at Radius 150, single_narrative at Radius 500)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path css:function ] ;
    sh:targetClass css:FunctionBreak .

css:RadiusConformance a sh:NodeShape ;
    rdfs:comment "Sections 4 to 9. The conformance status of one crossed Radius: the Radius rendered as its typed threshold structure, with its minimum conditions enumerated by status and its maximum conditions checked. A crossed Radius carries its conditions or it is not a conformance claim, so radius, minimum_conditions, and maximum_conditions are required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Section (Radius).5. Whether the Radius's interface conditions are documented and externally legible." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path css:interface_conditions_documented ],
        [ sh:class css:ConditionStatus ;
            sh:description "The Radius's maximum conditions, each with whether it is absent (the capture vector closed) or present (a conformance failure)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path css:maximum_conditions ],
        [ sh:class css:CoordinationRadius ;
            sh:description "The crossed Radius, as its typed threshold structure." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path css:radius ],
        [ sh:class css:ConditionStatus ;
            sh:description "The Radius's minimum conditions, each with its installed status. These are the floor at this threshold, the compressive bound on generative scaling: a hard lower bound that must be present, so a single absent minimum condition is a conformance breach that does not aggregate away against conditions met elsewhere (the floor-aware, non-averaging discipline). This is also the structural weld: a crossed Radius cannot claim conformance while silent on its minimum conditions." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path css:minimum_conditions ] ;
    sh:targetClass css:RadiusConformance .

css:ConditionStatus a sh:NodeShape ;
    rdfs:comment "One minimum or maximum condition and its status, so a condition is never asserted without an installed-or-absent determination." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The condition's status against the unit." ;
            sh:in ( "present" "absent" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path css:status ],
        [ sh:datatype xsd:string ;
            sh:description "The condition, stated operationally." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path css:condition ],
        [ sh:datatype xsd:string ;
            sh:description "A computable signal that indicates where to look for the condition's presence or absence; it locates the check, it does not by itself prove installation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path css:detection_signal ] ;
    sh:targetClass css:ConditionStatus .


