@prefix iacs: <https://standards.example/iacs/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iacs:IACSConformanceRecord a sh:NodeShape ;
    rdfs:comment "A system's declaration of the mechanisms it instruments, its classifications, its detection architecture, and its conformance." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class iacs:Classification ;
            sh:description "Section 6. The classifications the system has produced, each referencing a mechanism and the signals observed." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path iacs:classifications ],
        [ sh:class iacs:AsymmetryMechanism ;
            sh:description "Section 6. The mechanisms the system identifies as applicable, rendered as structured objects (the code system, not a label list). Each carries its causal process, detection surface, orthogonality, status, Cynefin domain, and remediation direction." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path iacs:applicable_mechanisms ],
        [ sh:class iacs:ConformanceDeclaration ;
            sh:description "Per-obligation conformance answers on the face; no total." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path iacs:conformance ],
        [ sh:class iacs:IACSArchitecture ;
            sh:description "The system's detection architecture and adopted tier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path iacs:architecture ] ;
    sh:targetClass iacs:IACSConformanceRecord .

iacs:AsymmetryMechanism a sh:NodeShape ;
    rdfs:comment "Section 2, 3, 5. One distinct information-asymmetry mechanism, individuated by its causal process and its detection surface, not by a label. A mechanism with no detection surface cannot be instrumented (Section 2 validity criterion 3), so detection_surface is required." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A named sub-pattern of this mechanism (for example, Distributed Monoculture, Coordination Record Asymmetry, Consensus Manufacturing)." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path iacs:sub_pattern ],
        [ sh:description "Section 5. Whether the mechanism is primary, a fully specified extension, or a scoped-out stub (not usable in a conforming detection architecture)." ;
            sh:in ( "primary" "extension_specified" "extension_stub_scoped_out" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path iacs:status ],
        [ sh:datatype xsd:string ;
            sh:description "Section 2 criterion 1. The distinct causal process by which advantage accumulates through informational position." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iacs:mechanism ],
        [ sh:description "Section 4.1. The Cynefin domain that sets the detection action mode." ;
            sh:in ( "clear" "complicated" "complex" "chaotic" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path iacs:cynefin_domain ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iacs:name ],
        [ sh:datatype xsd:string ;
            sh:description "Section 2 criterion 3. The observable signals in the coordination record that indicate the mechanism is active." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iacs:detection_surface ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 2 criterion 4. True when the mechanism is individuated at the level of causal process, so its presence does not entail another's." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iacs:orthogonal_at_mechanism ],
        [ sh:datatype xsd:string ;
            sh:description "Section 5 Scope. The structural remediation direction the mechanism implies; a pointer, since IACS defers the remediation architecture." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path iacs:remediation_direction ],
        [ sh:datatype xsd:string ;
            sh:description "The mechanism handle (for example, positional, interpretive, synthetic_coordination)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iacs:id ] ;
    sh:targetClass iacs:AsymmetryMechanism .

iacs:Classification a sh:NodeShape ;
    rdfs:comment "Section 6. One classification of a coordination record against a mechanism." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The handle of the mechanism assigned (references an applicable_mechanisms entry)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path iacs:mechanism ],
        [ sh:description "Section 4.1. The Cynefin domain classification applied, with its action mode." ;
            sh:in ( "clear" "complicated" "complex" "chaotic" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path iacs:cynefin_domain ],
        [ sh:datatype xsd:string ;
            sh:description "The specific detection-surface signals observed in the record." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iacs:detection_signals_observed ] ;
    sh:targetClass iacs:Classification .

iacs:ConformanceDeclaration a sh:NodeShape ;
    rdfs:comment "The per-obligation conformance answers on the face. There is deliberately no overall or total field: conformance is per-obligation, mirroring the suite's refusal to collapse a profile into a single number." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path iacs:detection_instrumented ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iacs:applicability_mapped ],
        [ sh:in ( "satisfied" "declared_absent_with_justification" "not_applicable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path iacs:classification_process_documented ] ;
    sh:targetClass iacs:ConformanceDeclaration .

iacs:IACSArchitecture a sh:NodeShape ;
    rdfs:comment "The system-level detection architecture and tier. Higher-tier fields are optional in the schema; the checker requires them at the tiers the register specifies." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Section 6 Instrumented. The audience linguistic, epistemic, and ontological baseline, required when Descriptive Capacity asymmetry is applicable in a document-production context." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path iacs:audience_baseline_declared ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 6 Instrumented. A real-time detection architecture instrumenting the surfaces, disclosed to participants." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path iacs:detection_architecture_present ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 6 Assessed. A class applicability inventory naming applicable, partial, and not-applicable mechanisms with a present, assumed, or absent detection state." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path iacs:applicability_inventory ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 6 Operational. A documented classification process per applicable mechanism." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path iacs:classification_process_documented ],
        [ sh:datatype xsd:boolean ;
            sh:description "Section 6 Instrumented. A documented Cynefin domain classification per mechanism with the matching action mode." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path iacs:cynefin_documented ],
        [ sh:in ( "assessed" "operational" "instrumented" "loop_closed" "auditable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path iacs:adopted_tier ] ;
    sh:targetClass iacs:IACSArchitecture .


